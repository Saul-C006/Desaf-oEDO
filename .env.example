# =====================================================================
# TECHFIX - Variables de entorno (EJEMPLO, sin credenciales reales)
# 1. Copie este archivo como ".env"   (cp .env.example .env)
# 2. Complete los valores reales SOLO en ".env".
# ".env" está en .gitignore: NUNCA se sube a GitHub.
# En el hosting, estas variables se configuran en su panel (no con archivo).
# =====================================================================

# Puerto del servidor web (en el hosting normalmente lo define el proveedor)
PORT=3000

# Conexión a MySQL (opción 1: variables separadas, p. ej. XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=techfix_app
DB_PASSWORD=escriba_aqui_su_contrasena
DB_NAME=techfix

# Opción 2 (nube, p. ej. Railway): una sola URL. Si se usa, NO defina DB_HOST.
# MYSQL_URL=mysql://usuario:clave@host:puerto/base

# Crear las tablas automáticamente si no existen (true/false)
DB_AUTO_INSTALAR=true

# Máximo de conexiones simultáneas (bajo, por los límites de planes gratuitos)
DB_CONNECTION_LIMIT=5

# Conexión cifrada (SSL/TLS). En local: false. En la nube normalmente: true.
DB_SSL=false
# Certificado CA del proveedor (opcional). Use UNA de las dos opciones:
#   - DB_SSL_CA_PATH: ruta a un archivo .pem
#   - DB_SSL_CA: contenido del certificado en una línea, con \n en los saltos de línea
DB_SSL_CA_PATH=
DB_SSL_CA=
# Verificar el certificado del servidor (recomendado: true)
DB_SSL_REJECT_UNAUTHORIZED=true
