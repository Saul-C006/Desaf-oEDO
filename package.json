{
  "name": "techfix",
  "version": "0.1.0",
  "description": "TECHFIX: simulación del crecimiento de clientes de un emprendimiento de soporte técnico mediante métodos numéricos (Analítica, Heun y RK4).",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:api": "node --test tests/api.test.js",
    "tabla": "node scripts/tabla.js",
    "datos-prueba": "node scripts/generar_datos_prueba.js",
    "test:e2e": "node tests/e2e/navegador.e2e.js",
    "verificar": "python tests/verificacion_independiente.py"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "mysql2": "^3.24.6",
    "pdfkit": "^0.20.2"
  }
}
